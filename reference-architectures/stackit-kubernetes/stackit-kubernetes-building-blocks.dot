/*
 * Building blocks of the STACKIT Kubernetes Platform, with their parents as meshPanel shows them.
 * Every box is a building block and every arrow points from parent to child; the frames show which
 * run orders the boxes inside them.
 * Conventions: .agents/references/diagrams.md — render with: task diagrams
 */
digraph stackit_kubernetes_building_blocks {
  rankdir=TB
  splines=ortho
  bgcolor="white"
  nodesep=0.55
  ranksep=0.7

  node [shape=box style="rounded,filled" fontname="Helvetica" fontsize=11
        fillcolor="#e5f2ea" color="#85bfa0" penwidth=1.1 margin="0.20,0.11"]
  edge [color="#8b95a3" arrowsize=0.7]

  subgraph cluster_outer {
    label="  ordered by STACKIT Kubernetes Platform <id>"
    labeljust=l
    fontname="Helvetica" fontsize=12 fontcolor="#697180"
    style="rounded" color="#d5dae0"
    margin=18

    SA    [label="🔑 Automation Identity\nstackit/service-account"]
    BOOT  [label="🤝 Bootstrap Identity Federation\nstackit/service-account-federation"]
    SVC   [label="📦 STACKIT Kubernetes Platform Services <id>" fillcolor="#ecedfb" color="#9aa2e6"]
  }

  subgraph cluster_platform {
    label="  ordered by STACKIT Kubernetes Platform Services <id>"
    labeljust=l
    fontname="Helvetica" fontsize=12 fontcolor="#697180"
    style="rounded" color="#d5dae0"
    margin=18

    FED     [label="🤝 Automation Identity Federation\nstackit/service-account-federation"]
    SKFED   [label="🤝 Starter Kit Identity Federation\nphase 2" style="rounded,filled,dashed"]
    SM      [label="🔒 Secrets Manager\nstackit/secrets-manager"]
    CLUSTER [label="☸️ SKE Cluster\nske/cluster"]
    GIT     [label="🔀 STACKIT Git Instance\nstackit/git"]
    REG     [label="🗄️ STACKIT Container Registry\nstackit/container-registry"]
    AI      [label="🧠 AI Model Serving\nstackit/ai-llm · optional" style="rounded,filled,dashed"]
    CREDS   [label="🔑 Kubernetes meshPlatform Credentials\nkubernetes"]
    ING     [label="🔐 Kubernetes Ingress\nkubernetes/ingress"]
    DNS     [label="🧭 DNS Zone\nstackit/dns"]

    { rank=same; SM -> CLUSTER -> GIT -> REG -> AI [style=invis] }
    { rank=same; CREDS -> ING [style=invis] }
  }

  SA      -> BOOT
  BOOT    -> SVC
  SA      -> FED
  SA      -> SKFED
  FED     -> SM
  FED     -> CLUSTER
  FED     -> GIT
  FED     -> REG
  FED     -> AI
  CLUSTER -> CREDS
  CLUSTER -> ING
  ING     -> DNS
  FED     -> DNS [constraint=false]
}
