/*
 * STACKIT Kubernetes (SKE) reference architecture — platform-team view.
 * The one-time bootstrap: what a platform engineer orders once, and the STACKIT infrastructure it
 * provisions. The per-application-team view is stackit-kubernetes-app-team.dot; the internal
 * building-block/federation wiring is stackit-kubernetes-building-blocks.dot.
 * Conventions: .agents/references/diagrams.md — render with: task diagrams
 */
digraph stackit_kubernetes_platform {
  rankdir=TB
  splines=ortho
  forcelabels=true
  bgcolor="white"
  nodesep=0.55
  ranksep=0.85

  node [shape=box style="rounded,filled" fontname="Helvetica" fontsize=11
        fillcolor="#ffffff" color="#a2abb8" penwidth=1.1 margin="0.20,0.11"]
  edge [fontname="Helvetica" fontsize=9 fontcolor="#697180" color="#8b95a3" arrowsize=0.7]

  // What it builds on — a whole reference architecture of its own, shown only for context.
  LZBB [label="🧱 STACKIT Landing Zone\nsee the STACKIT Landing Zone ref-arch"
        style="rounded,filled,dashed" fillcolor="#f0f1f3" color="#cdd2d8" fontcolor="#99a1ac"]

  subgraph cluster_mesh {
    label="  meshStack — registered once per platform"
    labeljust=l
    fontname="Helvetica" fontsize=12 fontcolor="#697180"
    style="rounded" color="#d5dae0"
    margin=18

    PLAT  [label="🛰️ SKE Platform" fillcolor="#ecedfb" color="#9aa2e6"]
    LZ    [label="🛬 Landing Zone ×N\none per stage" fillcolor="#ecedfb" color="#9aa2e6"]

    BBD_A [label="📦 kubernetes BBD\nreplicator + metering identities" fillcolor="#ecedfb" color="#9aa2e6"]
    BBD_K [label="📦 ske/cluster BBD" fillcolor="#ecedfb" color="#9aa2e6"]
    BBD_I [label="📦 kubernetes/ingress BBD\ncert-manager · HAProxy · ClusterIssuer" fillcolor="#ecedfb" color="#9aa2e6"]
    BBD_G [label="📦 stackit/git BBD" fillcolor="#ecedfb" color="#9aa2e6"]
    BBD_H [label="📦 stackit/container-registry BBD\nregistry · base image mirror · robots" fillcolor="#ecedfb" color="#9aa2e6"]
    BBD_D [label="📦 stackit/dns BBD" fillcolor="#ecedfb" color="#9aa2e6"]
    BBD_M [label="📦 stackit/ai-llm BBD" fillcolor="#ecedfb" color="#9aa2e6"]

    { rank=same; PLAT -> LZ [style=invis] }
    { rank=same; BBD_A -> BBD_K -> BBD_I -> BBD_G -> BBD_H -> BBD_D -> BBD_M [style=invis] }

    PLAT -> BBD_A [style=invis]
  }

  subgraph cluster_stackit {
    label="  STACKIT — provisioned infrastructure"
    labeljust=l
    fontname="Helvetica" fontsize=12 fontcolor="#697180"
    style="rounded" color="#d5dae0"
    margin=18

    AGENT  [label="🔑 meshStack identities\nreplicator + metering" fillcolor="#eef2f6" color="#93a7bb"]
    SKE    [label="☸️ SKE cluster\nrun by the platform team" fillcolor="#eef2f6" color="#93a7bb"]
    ING    [label="🔐 Ingress + cert-manager\nHAProxy LoadBalancer · Let's Encrypt" fillcolor="#eef2f6" color="#93a7bb"]
    GIT    [label="🔀 STACKIT Git\nForgejo instance" fillcolor="#eef2f6" color="#93a7bb"]
    HARBOR [label="🗄️ STACKIT Container Registry\nHarbor project per platform" fillcolor="#eef2f6" color="#93a7bb"]
    DNS    [label="🧭 STACKIT DNS zone\nwildcard to the load balancer" fillcolor="#eef2f6" color="#93a7bb"]
    MODEL  [label="🧠 STACKIT Model Serving\nsovereign LLM API" fillcolor="#eef2f6" color="#93a7bb"]

    { rank=same; AGENT -> SKE -> ING -> GIT -> HARBOR -> DNS -> MODEL [style=invis] }
  }

  LZBB -> PLAT [xlabel="hosts platform" style=dotted]

  // Each definition sits directly above the resource it provisions, so these read as short columns.
  BBD_A -> AGENT  [xlabel="provisions"]
  BBD_K -> SKE
  BBD_I -> ING
  BBD_G -> GIT
  BBD_H -> HARBOR
  BBD_D -> DNS
  BBD_M -> MODEL
}
