/*
 * T Cloud Public Landing Zone reference architecture.
 * Conventions: .agents/references/diagrams.md — render with: task diagrams
 */
digraph otc_landingzone {
  rankdir=TB
  splines=ortho
  forcelabels=true
  bgcolor="white"
  nodesep=0.55
  ranksep=0.85

  node [shape=box style="rounded,filled" fontname="Helvetica" fontsize=11
        fillcolor="#ffffff" color="#a2abb8" penwidth=1.1 margin="0.20,0.11"]
  edge [fontname="Helvetica" fontsize=9 fontcolor="#697180" color="#8b95a3" arrowsize=0.7]

  subgraph cluster_idp {
    label="  Company"
    labeljust=l
    fontname="Helvetica" fontsize=12 fontcolor="#697180"
    style="rounded" color="#d5dae0"
    margin=18

    IDP [label="🪪 Identity Provider\nSAML or OIDC" fillcolor="#ffffff" color="#a2abb8"]
  }

  subgraph cluster_otc {
    label="  T Cloud Public"
    labeljust=l
    fontname="Helvetica" fontsize=12 fontcolor="#697180"
    style="rounded" color="#d5dae0"
    margin=18

    DOMAIN  [label="🏢 Domain (OTC-EU-DE-…)" fillcolor="#ffffff" color="#a2abb8"]
    BPUSER  [label="🔑 Backplane IAM User\naccess key" fillcolor="#ffffff" color="#a2abb8"]
    FED     [label="🔗 Federated Identity Provider\none shared mapping" fillcolor="#ffffff" color="#a2abb8"]
    BUCKET  [label="🪣 Mapping Bucket\nmappings/<project>.json" fillcolor="#ffffff" color="#a2abb8"]
    MGMT    [label="🛠️ Management Project\neu-de_<platform>-mgmt" fillcolor="#ffffff" color="#a2abb8"]
    FUNC    [label="⚡ FunctionGraph Function\nrebuilds the mapping" fillcolor="#ffffff" color="#a2abb8"]
    REGION  [label="📁 Region Project (eu-de)" fillcolor="#ffffff" color="#a2abb8"]
    PRJ     [label="🗂️ Project eu-de_<project> ×N" fillcolor="#e5f2ea" color="#85bfa0"]
    GROUPS  [label="👥 IAM Groups ×3 per project\nadmin · user · reader" fillcolor="#e5f2ea" color="#85bfa0"]

    { rank=same; BPUSER -> FED -> BUCKET -> REGION [style=invis] }

    DOMAIN -> BPUSER
    DOMAIN -> FED
    DOMAIN -> REGION
    REGION -> PRJ    [xlabel="parent of"]
    REGION -> MGMT   [xlabel="parent of"]
    MGMT   -> FUNC   [xlabel="runs"]
    GROUPS -> PRJ    [xlabel="roles on"]
    BUCKET -> FUNC   [xlabel="triggers" style=dashed constraint=false]
    FUNC   -> FED    [xlabel="rebuilds mapping" style=dashed constraint=false]
    FED    -> GROUPS [xlabel="maps users into" style=dashed constraint=false]
  }

  subgraph cluster_mesh {
    label="  meshStack"
    labeljust=l
    fontname="Helvetica" fontsize=12 fontcolor="#697180"
    style="rounded" color="#d5dae0"
    margin=18

    PLAT   [label="🛰️ T Cloud Public Project Platform" fillcolor="#ecedfb" color="#9aa2e6"]
    LZ     [label="🛬 Default Landing Zone" fillcolor="#ecedfb" color="#9aa2e6"]
    PRJBBD [label="📦 otc/project BBD" fillcolor="#ecedfb" color="#9aa2e6"]
    MGMTT  [label="🛠️ Management Tenant\n<platform>-mgmt" fillcolor="#e5f2ea" color="#85bfa0"]
    FMBBD  [label="📦 otc/federation-mapping BBD\nordered once on the management tenant" fillcolor="#ecedfb" color="#9aa2e6"]

    PLAT  -> LZ
    LZ    -> PRJBBD [xlabel="requests"]
    LZ    -> MGMTT  [xlabel="holds"]
    MGMTT -> FMBBD  [xlabel="orders"]
  }

  IDP    -> FED    [xlabel="federated into" style=dotted constraint=false]
  BPUSER -> PRJBBD [xlabel="authenticates" style=dotted constraint=false]
  PRJBBD -> PRJ    [xlabel="provisions" style=dotted constraint=false]
  PRJBBD -> BUCKET [xlabel="records members" style=dotted constraint=false]
  FMBBD  -> FUNC   [xlabel="provisions" style=dotted constraint=false]
}
