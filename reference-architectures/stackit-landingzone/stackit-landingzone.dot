/*
 * STACKIT Landing Zone reference architecture.
 * Conventions: .agents/references/diagrams.md — render with: task diagrams
 */
digraph stackit_landingzone {
  rankdir=TB
  splines=ortho
  forcelabels=true
  bgcolor="white"
  nodesep=0.55
  ranksep=0.85

  node [shape=box style="rounded,filled" fontname="Helvetica" fontsize=11
        fillcolor="#ffffff" color="#a2abb8" penwidth=1.1 margin="0.20,0.11"]
  edge [fontname="Helvetica" fontsize=9 fontcolor="#697180" color="#8b95a3" arrowsize=0.7]

  subgraph cluster_mesh {
    label="  meshStack"
    labeljust=l
    fontname="Helvetica" fontsize=12 fontcolor="#697180"
    style="rounded" color="#d5dae0"
    margin=18

    node [fillcolor="#ecedfb" color="#9aa2e6"]

    PLAT   [label="🛰️ STACKIT Platform"]
    DEFLZ  [label="🛬 Default Landing Zone\nsandbox"]
    NETLZ  [label="🛬 Spoke Landing Zone\noptional · hub&spoke"]
    PRJBBD [label="📦 STACKIT Project\nmarketplace · one per tenant"]
    NETBBD [label="📦 STACKIT Network\nspoke landing zone"]
    SABBD  [label="📦 STACKIT Service Account\nself-service"]

    { rank=same; DEFLZ -> NETLZ [style=invis] }
    { rank=same; PRJBBD -> NETBBD -> SABBD [style=invis] }

    PLAT  -> DEFLZ
    PLAT  -> NETLZ
    DEFLZ -> PRJBBD [xlabel="offers"]
    NETLZ -> PRJBBD
    NETLZ -> NETBBD [xlabel="offers"]
    PRJBBD -> NETBBD [xlabel="orders one" style=dashed]
  }

  subgraph cluster_stackit {
    label="  STACKIT"
    labeljust=l
    fontname="Helvetica" fontsize=12 fontcolor="#697180"
    style="rounded" color="#d5dae0"
    margin=18

    FOUND  [label="🔑 Foundation Project\nproject-creation service account"]
    FOLDER [label="📁 Landing Zone Folder"]
    NA     [label="🌐 Network Area ×1\noptional · hub" fillcolor="#e5f2ea" color="#85bfa0"]
    PRJ    [label="🗂️ STACKIT Project ×N" fillcolor="#e5f2ea" color="#85bfa0"]
    SA     [label="🔑 Service Account ×N" fillcolor="#e5f2ea" color="#85bfa0"]
    NET    [label="🔌 Network ×N\nspoke" fillcolor="#e5f2ea" color="#85bfa0"]

    { rank=same; FOLDER -> NA -> FOUND [style=invis] }
    { rank=same; NET -> SA [style=invis] }

    FOLDER -> PRJ [xlabel="holds"]
    PRJ    -> SA
    PRJ    -> NET
    NA     -> NET [xlabel="assigns CIDR" style=dashed]
  }

  PRJBBD -> FOLDER [style=invis]
  NETBBD -> NA     [style=invis]
  SABBD  -> FOUND  [style=invis]

  PRJBBD -> PRJ [style=dotted]
  NETBBD -> NET [style=dotted]
  SABBD  -> SA  [xlabel="creates" style=dotted]
}
