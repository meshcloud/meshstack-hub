#cloud-config
package_update: true
packages:
  - docker.io
  - curl
  - ca-certificates
  - git
  - python3
  - python-is-python3
  - xz-utils

write_files:
  - path: /etc/git-runner/config.yml
    permissions: "0644"
    content: |
      log:
        level: info
      runner:
        file: /var/lib/git-runner/.runner
        capacity: 1
        timeout: 3h
        # Labels come from the .runner file written at registration.
        labels: []
      container:
        network: bridge
        privileged: false

  - path: /etc/systemd/system/git-runner.service
    permissions: "0644"
    content: |
      [Unit]
      Description=STACKIT Git Actions Runner
      After=docker.service network-online.target
      Requires=docker.service
      Wants=network-online.target

      [Service]
      User=git-runner
      WorkingDirectory=/var/lib/git-runner
      ExecStart=/usr/local/bin/git-runner daemon --config /etc/git-runner/config.yml
      Restart=always
      RestartSec=5

      [Install]
      WantedBy=multi-user.target

runcmd:
  - systemctl enable --now docker
  - useradd --system --create-home --home-dir /var/lib/git-runner --shell /usr/sbin/nologin git-runner || true
  - usermod -aG docker git-runner
  # Jobs run on the host, and Ubuntu 22.04's Node 12 is too old for actions/checkout@v4.
  - curl -fsSL "https://nodejs.org/dist/v${node_version}/node-v${node_version}-linux-x64.tar.xz" -o /tmp/node.tar.xz
  - tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1
  - rm -f /tmp/node.tar.xz
  - curl -fsSL "https://code.forgejo.org/forgejo/runner/releases/download/v${runner_version}/forgejo-runner-${runner_version}-linux-amd64" -o /usr/local/bin/git-runner
  - chmod +x /usr/local/bin/git-runner
  - su -s /bin/sh git-runner -c 'cd /var/lib/git-runner && /usr/local/bin/git-runner register --no-interactive --instance "${git_url}" --token "${registration_token}" --name "${runner_name}" --labels "${runner_labels}"'
  - systemctl enable --now git-runner
