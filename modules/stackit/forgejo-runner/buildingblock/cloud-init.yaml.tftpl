#cloud-config
# Provisions a self-hosted Forgejo Actions runner on first boot: installs Docker and the
# forgejo-runner binary, registers against the STACKIT Git instance using the org-scoped
# registration token, and runs the daemon under systemd so it survives reboots.
package_update: true
packages:
  - docker.io
  - curl
  - ca-certificates

write_files:
  - path: /etc/forgejo-runner/config.yml
    permissions: "0644"
    content: |
      log:
        level: info
      runner:
        file: /var/lib/forgejo-runner/.runner
        # One concurrent job on a single persistent VM. Raise once the pool grows.
        capacity: 1
        timeout: 3h
        # Labels live in the .runner file produced at registration below.
        labels: []
      container:
        network: bridge
        privileged: false

  - path: /etc/systemd/system/forgejo-runner.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Forgejo Actions Runner
      After=docker.service network-online.target
      Requires=docker.service
      Wants=network-online.target

      [Service]
      User=forgejo-runner
      WorkingDirectory=/var/lib/forgejo-runner
      ExecStart=/usr/local/bin/forgejo-runner daemon --config /etc/forgejo-runner/config.yml
      Restart=always
      RestartSec=5

      [Install]
      WantedBy=multi-user.target

runcmd:
  - systemctl enable --now docker
  - useradd --system --create-home --home-dir /var/lib/forgejo-runner --shell /usr/sbin/nologin forgejo-runner || true
  - usermod -aG docker forgejo-runner
  - curl -fsSL "https://code.forgejo.org/forgejo/runner/releases/download/v${forgejo_runner_version}/forgejo-runner-${forgejo_runner_version}-linux-amd64" -o /usr/local/bin/forgejo-runner
  - chmod +x /usr/local/bin/forgejo-runner
  # Register once; writes /var/lib/forgejo-runner/.runner with the long-lived runner token.
  - su -s /bin/sh forgejo-runner -c 'cd /var/lib/forgejo-runner && /usr/local/bin/forgejo-runner register --no-interactive --instance "${forgejo_url}" --token "${registration_token}" --name "${runner_name}" --labels "${runner_labels}"'
  - systemctl enable --now forgejo-runner
